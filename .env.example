# Root Environment Variables Example
# Copy this to .env and modify as needed

# MongoDB Connection
MONGO_URI=mongodb://localhost:27017/urlshortner

# Service Ports
URL_SERVICE_PORT=3001
REDIRECT_SERVICE_PORT=3002
ANALYTICS_SERVICE_PORT=3003
GATEWAY_PORT=8080

# Service URLs (for direct access, not needed when using docker-compose)
URL_SERVICE_URL=http://localhost:3001
REDIRECT_SERVICE_URL=http://localhost:3002
ANALYTICS_SERVICE_URL=http://localhost:3003